# Kept deliberately. Separate pod projects force cross-module imports to be framework-style
# (#import <SwrveSDKCommon/Foo.h>) rather than plain (#import "Foo.h"), which is why the SDK headers
# wrap them in __has_include checks. This is the only sample with the setting, so it is the only
# thing exercising that path — the others cover the plain-import case. See MOBILE-33124, which was
# missed precisely because this sample was not in CI at the time.
install! 'cocoapods', :generate_multiple_pod_projects => true, :incremental_installation => true

platform :ios, '16.0'

target 'MessageCenterSample' do
  use_frameworks!

  pod 'SwrveSDK'
# To build against local SDK source instead, comment out the line above and uncomment these two:
#  pod 'SwrveSDK', :path => '../../'
#  pod 'SwrveSDKCommon', :path => '../../'

end
